<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Pywel Trainer · Crimson Desert" Width="1320" Height="870" MinWidth="1100" MinHeight="740" WindowStartupLocation="CenterScreen" Background="#11151D" Foreground="#F3F2EF" FontFamily="Segoe UI" FontSize="14">
  <Window.Resources>
    <SolidColorBrush x:Key="Muted" Color="#9AA6BA"/>
    <SolidColorBrush x:Key="Amber" Color="#F3BE71"/>
    <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
    <Style x:Key="Caption" TargetType="TextBlock"><Setter Property="Foreground" Value="#9AA6BA"/><Setter Property="FontSize" Value="12"/></Style>
    <Style x:Key="Title" TargetType="TextBlock"><Setter Property="FontSize" Value="29"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,8"/></Style>
    <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="#1B2230"/><Setter Property="BorderBrush" Value="#30394A"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="14"/><Setter Property="Padding" Value="22"/></Style>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="#F3F2EF"/><Setter Property="Background" Value="#2B3546"/><Setter Property="BorderBrush" Value="#40516A"/><Setter Property="Padding" Value="15,10"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Face" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Face" Property="Opacity" Value="0.82"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.38"/><Setter Property="Cursor" Value="Arrow"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Face" Property="Opacity" Value="0.60"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#F3BE71"/><Setter Property="Foreground" Value="#17191F"/><Setter Property="BorderBrush" Value="#F3BE71"/></Style>
    <Style TargetType="TextBox"><Setter Property="Foreground" Value="#F3F2EF"/><Setter Property="Background" Value="#111822"/><Setter Property="BorderBrush" Value="#465269"/><Setter Property="Padding" Value="11,9"/><Setter Property="CaretBrush" Value="#F3BE71"/><Setter Property="SelectionBrush" Value="#815F36"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
    <Style TargetType="ComboBox"><Setter Property="Foreground" Value="#F3F2EF"/><Setter Property="Background" Value="#111822"/><Setter Property="Padding" Value="9,7"/><Setter Property="MinHeight" Value="39"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid><ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="#111822" BorderBrush="#465269" BorderThickness="1" CornerRadius="5"><Path Data="M 0,0 L 5,5 L 10,0" Stroke="#9AA6BA" StrokeThickness="1.4" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"/></Border></ControlTemplate></ToggleButton.Template></ToggleButton><ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" Margin="11,0,32,0" VerticalAlignment="Center" IsHitTestVisible="False"/><Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade"><Border Background="#1B2230" BorderBrush="#465269" BorderThickness="1" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" Padding="4"><ScrollViewer MaxHeight="280"><ItemsPresenter/></ScrollViewer></Border></Popup></Grid></ControlTemplate></Setter.Value></Setter></Style>
    <Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="#F3F2EF"/><Setter Property="Padding" Value="10,9"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="Choice" Background="Transparent" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Choice" Property="Background" Value="#3B4659"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <Style x:Key="Nav" TargetType="RadioButton"><Setter Property="Foreground" Value="#A7B2C5"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Margin" Value="0,0,0,6"/><Setter Property="Padding" Value="16,14"/><Setter Property="FontSize" Value="14"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton"><Border x:Name="NavFace" CornerRadius="8" Padding="{TemplateBinding Padding}" Background="Transparent"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="NavFace" Property="Background" Value="#30303A"/><Setter Property="Foreground" Value="#F3BE71"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="NavFace" Property="Background" Value="#262D3A"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#F3F2EF"/><Setter Property="FontSize" Value="17"/><Setter Property="Cursor" Value="Hand"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="66"/></Grid.ColumnDefinitions><ContentPresenter VerticalAlignment="Center" Margin="0,0,15,0"/><Border Grid.Column="1" x:Name="Track" Background="#3A4556" CornerRadius="13" Width="46" Height="26" HorizontalAlignment="Right"><Ellipse x:Name="Thumb" Width="18" Height="18" Fill="#B5C0D1" HorizontalAlignment="Left" Margin="4,0"/></Border></Grid><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Track" Property="Background" Value="#F3BE71"/><Setter TargetName="Thumb" Property="Fill" Value="#252733"/><Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.43"/><Setter Property="Cursor" Value="Arrow"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <Style TargetType="ListBox"><Setter Property="Background" Value="#121923"/><Setter Property="Foreground" Value="#F3F2EF"/><Setter Property="BorderBrush" Value="#323E51"/><Setter Property="BorderThickness" Value="1"/><Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style>
    <Style TargetType="ListBoxItem"><Setter Property="Foreground" Value="#F3F2EF"/><Setter Property="Padding" Value="11,9"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Row" Background="Transparent" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="#554B3B"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="#303A4B"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <DataTemplate x:Key="ItemTemplate"><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14"/><TextBlock Text="{Binding Detail}" Foreground="#9AA6BA" FontSize="11" Margin="0,4,0,0"/></StackPanel></DataTemplate>
  </Window.Resources>
  <Grid Background="#11151D">
    <Grid.ColumnDefinitions><ColumnDefinition Width="226"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Grid.Column="0" Background="#151B25" BorderBrush="#2B3444" BorderThickness="0,0,1,0">
      <Grid Margin="18,27,18,22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="12,0,0,28"><TextBlock Text="P Y W E L" FontSize="26" FontWeight="Bold" Foreground="#F3BE71"/><TextBlock Text="CRIMSON DESERT TRAINER" FontSize="9" Foreground="#A7B2C5" Margin="1,7,0,0"/></StackPanel>
        <StackPanel Grid.Row="1"><RadioButton x:Name="NavOverview" GroupName="Nav" Content="Übersicht" Style="{StaticResource Nav}" IsChecked="True"/><RadioButton x:Name="NavPlayer" GroupName="Nav" Content="Spieler" Style="{StaticResource Nav}"/><RadioButton x:Name="NavItems" GroupName="Nav" Content="Geld &amp; Waffen" Style="{StaticResource Nav}"/><RadioButton x:Name="NavTravel" GroupName="Nav" Content="Reisen" Style="{StaticResource Nav}"/><RadioButton x:Name="NavLog" GroupName="Nav" Content="Protokoll" Style="{StaticResource Nav}"/></StackPanel>
        <Border Grid.Row="3" Background="#1F2734" CornerRadius="10" Padding="14"><StackPanel><TextBlock Text="LOKAL AUF DEINEM PC" Foreground="#F3BE71" FontSize="10" FontWeight="SemiBold"/><TextBlock Text="Verbinde den Trainer, sobald dein Spielstand geladen ist." Foreground="#A7B2C5" FontSize="12" Margin="0,8,0,0"/><TextBlock x:Name="BackendLabel" Text="Verbindung wird vorbereitet …" Foreground="#78889F" FontSize="10" Margin="0,12,0,0"/></StackPanel></Border>
      </Grid>
    </Border>
    <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Border BorderBrush="#2B3444" BorderThickness="0,0,0,1" Padding="30,20"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="DEIN SPIEL. DEINE MÖGLICHKEITEN." FontSize="10" Foreground="#9AA6BA" FontWeight="SemiBold"/><TextBlock x:Name="HeaderSubtitle" Text="Externer Trainer für Crimson Desert" FontSize="14" Margin="0,5,0,0"/></StackPanel><Border Grid.Column="1" Background="#252D3B" CornerRadius="18" Padding="13,8" Margin="14,0" VerticalAlignment="Center"><StackPanel Orientation="Horizontal"><Ellipse x:Name="StateDot" Fill="#8A97AD" Width="7" Height="7" Margin="0,0,8,0"/><TextBlock x:Name="ConnectionBadge" Text="Nicht verbunden" Foreground="#BCC7D8" FontSize="12"/></StackPanel></Border><Button x:Name="AttachButton" Grid.Column="2" Content="Mit Spiel verbinden" Style="{StaticResource Primary}" VerticalAlignment="Center"/></Grid></Border>
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="30,25,30,28">
          <StackPanel x:Name="OverviewPanel">
            <TextBlock Text="Alles im Blick." Style="{StaticResource Title}"/><TextBlock Text="Verbinde dein laufendes Spiel und wähle anschließend deine Cheats." Foreground="#9AA6BA" Margin="0,0,0,23"/>
            <Border Style="{StaticResource Card}" Background="#222A38" Padding="25"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="190"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="VERBINDUNG ZUM SPIEL" Style="{StaticResource Caption}"/><TextBlock x:Name="OverviewState" Text="Warte auf Crimson Desert" FontSize="23" FontWeight="SemiBold" Margin="0,9,0,8"/><TextBlock x:Name="OverviewMessage" Text="Starte das Spiel über Steam und lade deinen Spielstand. Danach kannst du den Trainer verbinden." Foreground="#B7C1D1"/><TextBlock x:Name="ProcessLabel" Text="Kein Spielprozess verbunden" Style="{StaticResource Caption}" Margin="0,17,0,0"/></StackPanel><StackPanel Grid.Column="1" Margin="22,0,0,0" VerticalAlignment="Center"><Button x:Name="RefreshButton" Content="Status aktualisieren" Margin="0,0,0,10"/><Button x:Name="InspectButton" Content="Installation prüfen"/></StackPanel></Grid></Border>
            <Grid Margin="0,17,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="15"/><ColumnDefinition/></Grid.ColumnDefinitions><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="SPIELVERSION" Style="{StaticResource Caption}"/><TextBlock x:Name="BuildLabel" Text="Noch nicht geprüft" FontSize="20" FontWeight="SemiBold" Margin="0,10,0,5"/><TextBlock x:Name="VersionLabel" Text="Die Installation wird beim Start geprüft." Style="{StaticResource Caption}"/></StackPanel></Border><Border Grid.Column="2" Style="{StaticResource Card}"><StackPanel><TextBlock Text="FUNKTIONEN" Style="{StaticResource Caption}"/><TextBlock x:Name="CapabilityLabel" Text="Prüfung nach Verbindung" FontSize="20" FontWeight="SemiBold" Margin="0,10,0,5"/><TextBlock Text="Nur erkannte Funktionen werden freigeschaltet." Style="{StaticResource Caption}"/></StackPanel></Border></Grid>
            <Border Style="{StaticResource Card}" Margin="0,17,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Sicherung vor dem Experimentieren" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Erstelle eine datierte Kopie der gefundenen Spielstände." Foreground="#9AA6BA" Margin="0,7,20,0"/></StackPanel><Button x:Name="BackupButton" Grid.Column="1" Content="Spielstände sichern" VerticalAlignment="Center"/></Grid></Border>
            <Border Background="#221F23" BorderBrush="#5B4433" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,17,0,0"><StackPanel><TextBlock Text="Deine ersten Schritte" Foreground="#F3BE71" FontWeight="SemiBold"/><TextBlock Text="1  Spielstand laden    ·    2  Trainer verbinden    ·    3  Funktion auswählen" Foreground="#D0C2B2" Margin="0,7,0,0"/><TextBlock Text="Inventaränderungen und Reisen werden erst durch deinen Klick ausgeführt." Foreground="#9AA6BA" FontSize="12" Margin="0,9,0,0"/></StackPanel></Border>
            <TextBlock Text="F:\Steam\steamapps\common\Crimson Desert" Foreground="#718198" FontSize="11" Margin="2,20,0,0"/>
          </StackPanel>
          <StackPanel x:Name="PlayerPanel" Visibility="Collapsed"><TextBlock Text="Spieler" Style="{StaticResource Title}"/><TextBlock Text="Schalte die laufende Auffüllung deiner Werte einzeln ein und aus." Foreground="#9AA6BA" Margin="0,0,0,23"/>
            <Border Style="{StaticResource Card}"><StackPanel><CheckBox x:Name="HealthToggle" Content="Lebenspunkte laufend auffüllen" IsEnabled="False"/><TextBlock x:Name="HealthValue" Text="Lebenspunkte: –" Foreground="#F3BE71" Margin="0,16,0,7"/><TextBlock Text="Füllt die Gesundheit regelmäßig auf. Sehr hoher Schaden kann dich zwischen den Auffüllungen weiterhin besiegen." Foreground="#9AA6BA" FontSize="12"/></StackPanel></Border>
            <Border Style="{StaticResource Card}" Margin="0,14,0,0"><StackPanel><CheckBox x:Name="StaminaToggle" Content="Ausdauer laufend auffüllen" IsEnabled="False"/><TextBlock x:Name="StaminaValue" Text="Ausdauer: –" Foreground="#F3BE71" Margin="0,16,0,7"/><TextBlock Text="Hält deine Ausdauer durch regelmäßiges Auffüllen verfügbar." Foreground="#9AA6BA" FontSize="12"/></StackPanel></Border>
            <Border Style="{StaticResource Card}" Margin="0,14,0,0"><StackPanel><CheckBox x:Name="SpiritToggle" Content="Geistenergie laufend auffüllen" IsEnabled="False"/><TextBlock x:Name="SpiritValue" Text="Geistenergie: –" Foreground="#F3BE71" Margin="0,16,0,7"/><TextBlock Text="Füllt den verfügbaren Geistenergiewert regelmäßig auf." Foreground="#9AA6BA" FontSize="12"/></StackPanel></Border>
            <TextBlock x:Name="PlayerAvailability" Text="Verbinde das Spiel, um die verfügbaren Funktionen zu prüfen." Foreground="#9AA6BA" Margin="0,19,0,0"/>
          </StackPanel>
          <StackPanel x:Name="ItemsPanel" Visibility="Collapsed">
            <TextBlock Text="Geld &amp; Waffen" Style="{StaticResource Title}"/>
            <TextBlock Text="Durchsuche die Gegenstände deiner Spielinstallation – auch ohne laufendes Spiel." Foreground="#9AA6BA" Margin="0,0,0,17"/>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.3*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
              <Border Style="{StaticResource Card}" Padding="18" VerticalAlignment="Top"><StackPanel>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Gegenstandskatalog" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/><Button x:Name="RebuildCatalogButton" Grid.Column="1" Content="Neu einlesen" Padding="10,7" FontSize="11" ToolTip="Katalog erneut aus den installierten Spieldateien erstellen"/></Grid>
                <TextBlock x:Name="CatalogSource" Text="Katalog wird aus den Spieldaten geladen …" Style="{StaticResource Caption}" Margin="0,8,0,13"/>
                <TextBox x:Name="CatalogQuery" ToolTip="Deutschen Namen, Beschreibung oder interne Kennung suchen"/>
                <Grid Margin="0,9,0,12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <ComboBox x:Name="CatalogCategory" SelectedIndex="0"><ComboBoxItem Content="Alle Gegenstände" Tag="all"/><ComboBoxItem Content="Waffen" Tag="weapons"/><ComboBoxItem Content="Rüstung" Tag="armor"/><ComboBoxItem Content="Materialien" Tag="materials"/><ComboBoxItem Content="Verbrauchsgegenstände" Tag="consumables"/><ComboBoxItem Content="Geld / Währung" Tag="currency"/><ComboBoxItem Content="Questgegenstände" Tag="quest"/><ComboBoxItem Content="Sonstiges" Tag="other"/></ComboBox>
                  <Button Grid.Column="2" x:Name="CatalogButton" Content="Suchen" IsEnabled="False"/>
                </Grid>
                <ListBox x:Name="CatalogList" Height="250" ItemTemplate="{StaticResource ItemTemplate}"/>
                <Grid Margin="0,10,0,14"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="6"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <TextBlock x:Name="CatalogCount" Text="Katalog wird geladen …" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                  <Button Grid.Column="1" x:Name="CatalogPreviousButton" Content="‹" ToolTip="Vorherige Seite" Padding="12,5" IsEnabled="False"/>
                  <Button Grid.Column="3" x:Name="CatalogNextButton" Content="›" ToolTip="Nächste Seite" Padding="12,5" IsEnabled="False"/>
                </Grid>
                <TextBlock Text="Anzahl hinzufügen" Style="{StaticResource Caption}" Margin="0,0,0,6"/>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="78"/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBox x:Name="AddQuantity" Text="1"/><Button Grid.Column="2" x:Name="AddButton" Content="Zum Inventar hinzufügen" Style="{StaticResource Primary}" IsEnabled="False"/></Grid>
                <TextBlock x:Name="CatalogAddStatus" Text="Zum Hinzufügen einen Spielstand laden und den Trainer verbinden." TextWrapping="Wrap" Style="{StaticResource Caption}" Margin="0,11,0,0"/>
              </StackPanel></Border>
              <StackPanel Grid.Column="2">
                <Border Style="{StaticResource Card}" Padding="18"><StackPanel>
                  <TextBlock Text="GEGENSTANDSDETAILS" FontSize="10" Foreground="#F3BE71" FontWeight="SemiBold"/>
                  <TextBlock x:Name="CatalogDetailName" Text="Gegenstand auswählen" FontSize="19" FontWeight="SemiBold" Margin="0,9,0,9"/>
                  <ScrollViewer MaxHeight="160" VerticalScrollBarVisibility="Auto"><TextBlock x:Name="CatalogDescription" Text="Details und Kennungen stammen aus deiner Spielinstallation." Foreground="#BAC4D3" FontSize="12"/></ScrollViewer>
                  <TextBlock x:Name="CatalogMetadata" Style="{StaticResource Caption}" Margin="0,13,0,0"/>
                </StackPanel></Border>
                <Border Style="{StaticResource Card}" Padding="18" Margin="0,15,0,0"><StackPanel>
                  <TextBlock Text="Dein Inventar" FontSize="18" FontWeight="SemiBold"/>
                  <TextBlock x:Name="InventoryAvailability" Text="Zum Lesen des Inventars einen Spielstand laden und den Trainer verbinden." TextWrapping="Wrap" Style="{StaticResource Caption}" Margin="0,7,0,10"/>
                  <Button x:Name="InventoryButton" Content="Inventar aus dem Spiel laden" HorizontalAlignment="Stretch" IsEnabled="False"/>
                  <ComboBox x:Name="InventoryStorage" SelectedIndex="0" Margin="0,10,0,0" ToolTip="Inventarbereich auswählen" IsEnabled="False"><ComboBoxItem Content="Figureninventar" Tag="Character"/><ComboBoxItem Content="Geld &amp; Marken" Tag="Money"/><ComboBoxItem Content="Questgegenstände" Tag="Quest"/><ComboBoxItem Content="Lager" Tag="CampWareHouse"/><ComboBoxItem Content="Alle Bereiche" Tag="all"/></ComboBox>
                  <ListBox x:Name="InventoryList" Height="140" Margin="0,12,0,0" ItemTemplate="{StaticResource ItemTemplate}"/>
                  <TextBlock x:Name="InventoryCount" Text="Noch nicht geladen" Style="{StaticResource Caption}" Margin="0,8,0,12"/>
                  <TextBlock Text="Neue Gesamtmenge" Style="{StaticResource Caption}" Margin="0,0,0,6"/>
                  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="78"/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBox x:Name="InventoryQuantity" Text="1"/><Button Grid.Column="2" x:Name="QuantityButton" Content="Menge setzen" IsEnabled="False"/></Grid>
                </StackPanel></Border>
                <TextBlock Text="Geldbeutel findest du unter „Geld / Währung“. Ein direkter Geldwert ist noch nicht verifiziert." Foreground="#DAC3A6" FontSize="11" Margin="2,14,2,0"/>
              </StackPanel>
            </Grid>
          </StackPanel>
          <StackPanel x:Name="TravelPanel" Visibility="Collapsed"><TextBlock Text="Reisen" Style="{StaticResource Title}"/><TextBlock Text="Springe zu einem vom Spiel erkannten Reiseziel." Foreground="#9AA6BA" Margin="0,0,0,23"/><Border Style="{StaticResource Card}"><StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="15"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Reiseziel suchen" Style="{StaticResource Caption}" Margin="0,0,0,6"/><TextBox x:Name="TravelQuery"/></StackPanel><Button Grid.Column="2" x:Name="DestinationsButton" Content="Reiseziele laden" VerticalAlignment="Bottom" IsEnabled="False"/></Grid><ListBox x:Name="DestinationsList" Height="318" Margin="0,17,0,0" ItemTemplate="{StaticResource ItemTemplate}"/><TextBlock x:Name="DestinationCount" Text="Reiseziele werden nach dem Verbinden aus dem Spiel gelesen." Foreground="#9AA6BA" FontSize="12" Margin="0,11,0,17"/><Button x:Name="TravelButton" Content="Zum ausgewählten Ziel reisen" Style="{StaticResource Primary}" IsEnabled="False" HorizontalAlignment="Right"/></StackPanel></Border><TextBlock Text="Verfügbare Ziele hängen vom geladenen Spielstand und der erkannten Spielversion ab." Foreground="#9AA6BA" FontSize="12" Margin="0,17,0,0"/></StackPanel>
          <StackPanel x:Name="LogPanel" Visibility="Collapsed"><TextBlock Text="Protokoll" Style="{StaticResource Title}"/><TextBlock Text="Verbindungen, ausgeführte Aktionen und verständliche Fehlermeldungen." Foreground="#9AA6BA" Margin="0,0,0,23"/><Border Style="{StaticResource Card}" Padding="18"><StackPanel><TextBox x:Name="LogText" IsReadOnly="True" TextWrapping="Wrap" Height="400" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12" AcceptsReturn="True"/><Grid Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="12"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button Grid.Column="1" x:Name="DiagnosticsButton" Content="Diagnose speichern"/><Button Grid.Column="3" x:Name="ClearLogButton" Content="Anzeige leeren"/></Grid></StackPanel></Border></StackPanel>
        </Grid>
      </ScrollViewer>
      <Border Grid.Row="2" Background="#151B25" BorderBrush="#2B3444" BorderThickness="0,1,0,0" Padding="30,12"><TextBlock x:Name="StatusText" Text="Bereit. Es wurden keine Änderungen am Spiel vorgenommen." Foreground="#A7B2C5" FontSize="12"/></Border>
    </Grid>
  </Grid>
</Window>
